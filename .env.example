# Neon: normally written to .env.local by `neon deploy` / `neon env pull`
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com → Credentials → OAuth client, type "Web")
# Redirect URI: http://localhost:3000/api/auth/callback/google (+ your Vercel URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails allowed to sign up
ALLOWED_EMAILS=
